generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, citext]
}

enum Role {
  LEARNER
  PARENT
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ConsentType {
  DATA_PROCESSING
  MARKETING
  AI_TUTOR
  PHOTO_USAGE
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GUARDIAN
  OTHER
}

enum GuardianLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  passwordHash    String    @map("password_hash")
  role            Role
  fullName        String    @map("full_name")
  phone           String?
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  isMinor         Boolean   @default(false) @map("is_minor")
  tenantId        String?   @map("tenant_id") @db.Uuid
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions       Session[]
  passwordResets PasswordReset[]
  consentRecords ConsentRecord[] @relation("LearnerConsent")
  guardianConsents ConsentRecord[] @relation("GuardianConsent")
  guardianLinks  GuardianLink[] @relation("GuardianUser")
  learnerLinks   GuardianLink[] @relation("LearnerUser")
  paymentOrders PaymentOrder[]

  @@index([tenantId])
  @@index([role])
  @@map("users")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceLabel      String?   @map("device_label")
  ipAddress        String?   @map("ip_address") @db.Text
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  lastUsedAt       DateTime  @map("last_used_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_resets")
}

model ConsentRecord {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  guardianId    String?     @map("guardian_id") @db.Uuid
  consentType   ConsentType @map("consent_type")
  grantedAt     DateTime    @map("granted_at") @db.Timestamptz
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz
  evidence      Json        @db.JsonB
  policyVersion String      @map("policy_version")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user    User  @relation("LearnerConsent", fields: [userId], references: [id])
  guardian User? @relation("GuardianConsent", fields: [guardianId], references: [id])

  @@index([userId])
  @@index([guardianId])
  @@map("consent_records")
}

model OutboxEvent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String   @map("aggregate_type")
  aggregateId  String    @map("aggregate_id") @db.Uuid
  eventType    String    @map("event_type")
  payload      Json      @db.JsonB
  status       OutboxStatus @default(PENDING)
  attempts     Int       @default(0)
  availableAt  DateTime  @map("available_at") @default(now()) @db.Timestamptz
  processedAt  DateTime? @map("processed_at") @db.Timestamptz
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, availableAt])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  DLQ
}

model Exam {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  versions ExamVersion[]
  subjects Subject[]

  @@map("exams")
}

model ExamVersion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId        String    @map("exam_id") @db.Uuid
  versionLabel  String    @map("version_label")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  sourceUrl     String?   @map("source_url")
  sourceNotes   String?   @map("source_notes")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  exam     Exam      @relation(fields: [examId], references: [id])
  subjects Subject[]

  @@unique([examId, versionLabel])
  @@map("exam_versions")
}

model Subject {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String
  name           String
  examId         String    @map("exam_id") @db.Uuid
  examVersionId  String?   @map("exam_version_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  exam    Exam         @relation(fields: [examId], references: [id])
  version ExamVersion? @relation(fields: [examVersionId], references: [id])
  objectives Objective[]
  questions Question[]
  contentPacks ContentPack[]

  @@unique([examId, code])
  @@map("subjects")
}

model Objective {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId       String    @map("subject_id") @db.Uuid
  code            String
  description     String
  parentObjectiveId String? @map("parent_objective_id") @db.Uuid
  examWeight      Decimal   @default(1.0) @map("exam_weight") @db.Decimal(4, 3)
  orderIndex      Int       @map("order_index")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  subject   Subject    @relation(fields: [subjectId], references: [id])
  parent    Objective? @relation("ObjectiveTree", fields: [parentObjectiveId], references: [id])
  children  Objective[] @relation("ObjectiveTree")
  questionLinks QuestionObjective[]

  @@unique([subjectId, code])
  @@index([parentObjectiveId])
  @@map("objectives")
}

enum QuestionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  RETIRED
}

model Question {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String?        @map("tenant_id") @db.Uuid
  subjectId       String         @map("subject_id") @db.Uuid
  type            String         @default("MCQ")
  difficulty      Int
  status          QuestionStatus @default(DRAFT)
  currentVersionId String?       @unique @map("current_version_id") @db.Uuid
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  subject Subject @relation(fields: [subjectId], references: [id])
  currentVersion QuestionVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions QuestionVersion[] @relation("QuestionVersions")
  objectives QuestionObjective[]

  @@index([subjectId])
  @@index([status])
  @@map("questions")
}

model QuestionVersion {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId  String    @map("question_id") @db.Uuid
  version     Int
  body        String
  options     Json      @db.JsonB
  answerKey   String    @map("answer_key")
  explanation String
  mediaUrls   Json      @default("[]") @map("media_urls") @db.JsonB
  authoredBy  String    @map("authored_by") @db.Uuid
  approvedBy  String?   @map("approved_by") @db.Uuid
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz
  provenance  Json      @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  question Question @relation("QuestionVersions", fields: [questionId], references: [id])
  currentFor Question? @relation("CurrentVersion")

  @@unique([questionId, version])
  @@map("question_versions")
}

model QuestionObjective {
  questionId  String  @map("question_id") @db.Uuid
  objectiveId String  @map("objective_id") @db.Uuid
  primary     Boolean @default(false)

  question  Question  @relation(fields: [questionId], references: [id])
  objective Objective @relation(fields: [objectiveId], references: [id])

  @@id([questionId, objectiveId])
  @@map("question_objectives")
}

model Attempt {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId       String    @map("learner_id") @db.Uuid
  examId          String    @map("exam_id") @db.Uuid
  subjectId       String    @map("subject_id") @db.Uuid
  mode            AttemptMode
  startedAt       DateTime  @map("started_at") @default(now()) @db.Timestamptz
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz
  totalQuestions  Int       @map("total_questions")
  correctCount    Int?      @map("correct_count")
  scorePct        Decimal?  @map("score_pct") @db.Decimal(5, 2)
  durationMs      Int?      @map("duration_ms")
  idempotencyKey  String    @unique @map("idempotency_key")
  deviceId        String?   @map("device_id")
  syncedFromOffline Boolean @default(false) @map("synced_from_offline")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  items AttemptItem[]

  @@index([learnerId])
  @@index([subjectId])
  @@map("attempts")
}

enum AttemptMode {
  DIAGNOSTIC
  PRACTICE
  CBT
  ASSIGNMENT
}

model AttemptItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId         String    @map("attempt_id") @db.Uuid
  questionId        String    @map("question_id") @db.Uuid
  questionVersionId String    @map("question_version_id") @db.Uuid
  response          String?
  isCorrect         Boolean?  @map("is_correct")
  timeMs            Int?      @map("time_ms")
  answeredAt        DateTime? @map("answered_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  attempt Attempt @relation(fields: [attemptId], references: [id])

  @@index([attemptId])
  @@index([questionId])
  @@map("attempt_items")
}

model MasteryEvent {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId          String   @map("learner_id") @db.Uuid
  objectiveId        String   @map("objective_id") @db.Uuid
  eventType          MasteryEventType @map("event_type")
  delta              Decimal  @db.Decimal(5, 4)
  sourceAttemptItemId String? @map("source_attempt_item_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([learnerId])
  @@index([objectiveId])
  @@map("mastery_events")
}

enum MasteryEventType {
  ATTEMPT
  DIAGNOSTIC
  DECAY
  MANUAL_ADJUST
}

model MasteryScore {
  learnerId      String   @map("learner_id") @db.Uuid
  objectiveId    String   @map("objective_id") @db.Uuid
  score          Decimal  @db.Decimal(5, 4)
  confidence     Decimal  @db.Decimal(5, 4)
  attemptsCount  Int      @default(0) @map("attempts_count")
  lastPracticedAt DateTime? @map("last_practiced_at") @db.Timestamptz
  nextReviewDueAt DateTime? @map("next_review_due_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([learnerId, objectiveId])
  @@map("mastery_scores")
}

model Cohort {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  teacherId String    @map("teacher_id") @db.Uuid
  name      String
  joinCode  String    @unique @map("join_code")
  examId    String    @map("exam_id") @db.Uuid
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  members CohortMember[]
  assignments Assignment[]

  @@map("cohorts")
}

model CohortMember {
  cohortId  String   @map("cohort_id") @db.Uuid
  learnerId String   @map("learner_id") @db.Uuid
  joinedAt  DateTime @map("joined_at") @default(now()) @db.Timestamptz

  cohort Cohort @relation(fields: [cohortId], references: [id])

  @@id([cohortId, learnerId])
  @@map("cohort_members")
}

model Assignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId     String   @map("cohort_id") @db.Uuid
  teacherId    String   @map("teacher_id") @db.Uuid
  title        String
  objectiveIds Json     @map("objective_ids") @db.JsonB
  dueAt        DateTime? @map("due_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cohort Cohort @relation(fields: [cohortId], references: [id])

  @@map("assignments")
}

enum ContentPackStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ContentPack {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId    String            @map("subject_id") @db.Uuid
  version      Int
  name         String
  status       ContentPackStatus @default(DRAFT)
  storageKey   String?           @map("storage_key")
  sizeBytes    Int?              @map("size_bytes")
  questionCount Int              @default(0) @map("question_count")
  publishedAt  DateTime?         @map("published_at") @db.Timestamptz
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([subjectId, version])
  @@map("content_packs")
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model PaymentOrder {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  amountKobo   Int                @map("amount_kobo")
  currency     String             @default("NGN")
  status       PaymentOrderStatus @default(PENDING)
  reference    String             @unique
  plan         String
  paidAt       DateTime?          @map("paid_at") @db.Timestamptz
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user   User           @relation(fields: [userId], references: [id])
  events PaymentEvent[]

  @@index([userId])
  @@map("payment_orders")
}

model PaymentEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  provider        String
  providerEventId String   @map("provider_event_id")
  payload         Json     @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  order PaymentOrder @relation(fields: [orderId], references: [id])

  @@unique([provider, providerEventId])
  @@map("payment_events")
}

model GuardianLink {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guardianId   String               @map("guardian_id") @db.Uuid
  learnerId    String               @map("learner_id") @db.Uuid
  relationship GuardianRelationship
  verifiedAt   DateTime?            @map("verified_at") @db.Timestamptz
  status       GuardianLinkStatus   @default(PENDING)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  guardian User @relation("GuardianUser", fields: [guardianId], references: [id])
  learner  User @relation("LearnerUser", fields: [learnerId], references: [id])

  @@unique([guardianId, learnerId])
  @@index([guardianId])
  @@index([learnerId])
  @@map("guardian_links")
}
