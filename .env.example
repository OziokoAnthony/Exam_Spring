# Database (matches docker-compose.yml for local dev)
DATABASE_URL="postgresql://examspring:examspring@localhost:5434/examspring?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# API
NODE_ENV="development"
API_PORT=3001

# Web
# The browser calls the API through the Next.js /api proxy (same origin).
NEXT_PUBLIC_API_URL="/api/v1"
# Where the Next.js /api proxy forwards to (server-side only).
API_ORIGIN="http://localhost:3001"

# Seed admin user (change before running db:seed)
SEED_ADMIN_EMAIL="admin@examspring.local"
SEED_ADMIN_PASSWORD="change-me-in-production"
SEED_ADMIN_NAME="ExamSpring Admin"

# Auth (Day 2 — placeholders for now)
JWT_ACCESS_SECRET="dev-access-secret-change-in-production-0123456789"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production-0123456"

# Email (Day 3)
RESEND_API_KEY=""
EMAIL_FROM="ExamSpring <noreply@examspring.local>"

# Web origin for CORS
WEB_ORIGIN="http://localhost:3000"

# Refresh cookie path as the browser sees it (through the /api proxy).
REFRESH_COOKIE_PATH="/api/v1/auth"

# Payments (Day: billing) - optional in dev (mocks when absent)
PAYSTACK_SECRET_KEY=


# Logging (Pino): fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# Error monitoring (Sentry). Leave empty to disable. Never enable session replay.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
# CI only, for source map upload. Never commit a real value.
SENTRY_AUTH_TOKEN=""
