{
  "name": "examspring",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "pnpm --filter @examspring/db generate && turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:migrate": "pnpm --filter @examspring/db migrate:dev",
    "db:seed": "pnpm --filter @examspring/db seed",
    "db:studio": "pnpm --filter @examspring/db studio",
    "prepare": "husky",
    "start": "node backend/dist/main.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "husky": "9.1.5",
    "lint-staged": "15.2.9",
    "prettier": "3.3.3",
    "turbo": "2.1.1",
    "typescript": "5.5.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20 <23",
    "pnpm": "^12.8.1"
  }
}
